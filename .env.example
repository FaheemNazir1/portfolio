# EmailJS Configuration Settings
# Create a copy of this file named ".env" in the same root directory and replace the placeholders.

# Your EmailJS Service ID (e.g. service_xxxxxxx)
VITE_EMAILJS_SERVICE_ID=your_service_id_here

# Your EmailJS Template ID (e.g. template_xxxxxxx)
VITE_EMAILJS_TEMPLATE_ID=your_template_id_here

# Your EmailJS Public Key (from Account -> API keys)
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here
